module types_tb;
  logic [1:0] sel;
  initial begin
    sel=2'b10;
    $display("sel=%0b",sel);
    $display("\n ======priority_if=====");
    priority if(sel[1])
      $display("PRIORITY IF:MSB=1");
    else if(sel==2'b10)
      $display("PRIORITY IF:MATCH 10");
    else
      $display("default");
    
     $display("\n===== UNIQUE IF =====");
    unique if (sel == 2'b00)
      $display("UNIQUE IF: 00");
    else if (sel == 2'b01)
      $display("UNIQUE IF: 01");
    else if (sel == 2'b10)
      $display("UNIQUE IF: 10");
    else if (sel == 2'b11)
      $display("UNIQUE IF: 11");
      
    $display("\n===== UNIQUE0 IF =====");
    unique0 if (sel == 2'b00)
      $display("UNIQUE0 IF: 00");
    else if (sel == 2'b01)
      $display("UNIQUE0 IF: 01");
    else if (sel == 2'b10)
      $display("UNIQUE0 IF: 10");
    else if (sel == 2'b11)
      $display("UNIQUE0 IF: 11");
  end
endmodule
