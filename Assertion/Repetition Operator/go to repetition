module tb;
  logic clk;
  logic reset;
  logic q;
  logic d;
  
    always #5 clk=~clk;
  
  always @(posedge clk) begin
    if(reset) 
      q<=0;
    else
      q<=d;
  end
  
  sequence s1;
    d ##1 q;
  endsequence
  sequence s2;
    q[->3];
  endsequence
  
  property p1;
    @(posedge clk)
    s1 |-> s2;
  endproperty
  
  assert property(p1)
    $display("[%0t] pass q follows d",$time);
             else
               $display("[%0t] fail q not follows d",$time);
initial begin
  reset=1;
  d=0;
  clk=0;
  
  #12 reset=0;
  #10 d=1;
  #10 d=0;
  #10 d=1;
  #10 d=1;
  #10 d=1;
#20;
  $finish;
end
                        
                        endmodule
               
