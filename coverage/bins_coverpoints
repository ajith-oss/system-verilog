module tb;
  logic clk;
   always #5 clk=~clk;
  
  class packet;
    rand bit[2:0] addr;
    rand bit write;
    covergroup cg;
      coverpoint addr{
        bins valid={0,1,3};
        ignore_bins reserved={4};
      }
      coverpoint write{
        bins write={0};
        bins read={1};
      }
      cross addr,write;
    endgroup
    
    function new();
      cg=new();
    endfunction
  endclass
  
  packet pkt;
  
  initial begin
    pkt=new();
    
    pkt.addr  = 0;
    pkt.write = 0;

    pkt.cg.sample();

    $display("--------------------------------------");
    $display("Transaction 1");
    $display("ADDR=%0d WRITE=%0d", pkt.addr, pkt.write);
    $display("Coverage = %0.2f%%", pkt.cg.get_coverage());
    
     pkt.addr  = 1;
    pkt.write = 0;

    pkt.cg.sample();

    $display("--------------------------------------");
    $display("Transaction 2");
    $display("ADDR=%0d WRITE=%0d", pkt.addr, pkt.write);
    $display("Coverage = %0.2f%%", pkt.cg.get_coverage());
    
      pkt.addr  = 2;
    pkt.write = 1;

    pkt.cg.sample();

    $display("--------------------------------------");
    $display("Transaction 3");
    $display("ADDR=%0d WRITE=%0d", pkt.addr, pkt.write);
    $display("Coverage = %0.2f%%", pkt.cg.get_coverage());
    
    pkt.addr  = 3;
    pkt.write = 1;

    pkt.cg.sample();

    $display("--------------------------------------");
    $display("Transaction 4");
    $display("ADDR=%0d WRITE=%0d", pkt.addr, pkt.write);
    $display("Coverage = %0.2f%%", pkt.cg.get_coverage());

    pkt.addr  = 2;
    pkt.write = 0;

    pkt.cg.sample();

    $display("--------------------------------------");
    $display("Transaction 5");
    $display("ADDR=%0d WRITE=%0d", pkt.addr, pkt.write);
    $display("Coverage = %0.2f%%", pkt.cg.get_coverage());

    $display("--------------------------------------");
    $display("Final Coverage = %0.2f%%", pkt.cg.get_coverage());

    $finish;
  end
endmodule
    
