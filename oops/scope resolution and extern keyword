class bank_account;
  string name;
  int balance;
  int account_no;
  static int total_account=0;
  extern function new(string n,int bal,int acc_no);
    extern function void deposit(int amount);
      extern function void withdrawal(int amount);
        extern function void display();
          endclass
          function bank_account::new(string n,int bal,int acc_no);
            name=n;
            balance=bal;
            account_no=acc_no;
            total_account++;
          endfunction
          function void bank_account::deposit(int amount);
            balance=balance+amount;
            $display("%s deposited %0d",name,amount);
          endfunction
          function void bank_account::withdrawal(int amount);
            balance=balance-amount;
            $display("%s withdrawal %d",name,amount);
          endfunction
          function void bank_account::display();
              $display("--------------------------------");
  $display("Name       : %s", name);
  $display("Account No : %0d", account_no);
  $display("Balance    : %0d", balance);
  $display("--------------------------------");
          endfunction
          module tb;
            bank_account acc1;
            bank_account acc2;
            initial begin
              acc1=new("AJITH",5000,10);
              acc2=new("sai",7000,11);
              acc1.deposit(2000);
              acc2.withdrawal(4000);
              $display("\n account1_details");
                       acc1.display();
              $display("\n account2_details");
                                acc2.display();
                                $display("\n total_account_created=%0d",bank_account::total_account);
                                end
                                endmodule
          
