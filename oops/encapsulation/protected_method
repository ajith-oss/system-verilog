class parent;

  protected int marks;

  function void set_mark(int m);

    if(m >= 0 && m <= 100)
      marks = m;
    else
      $display("INVALID MARK");

  endfunction

endclass


class child extends parent;

  function int get_marks();

    return marks;

  endfunction

  function void display();

    $display("MARKS : %0d", marks);

  endfunction

endclass


module tb;

  child c1;

  initial begin

    c1 = new();

    c1.set_mark(90);

    c1.display();

  end

endmodule
