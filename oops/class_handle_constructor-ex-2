class bank_account;
  int balance;
  int deposit;
  string ac_name;
  int account_num;
  int withdrawal;
  function new(int balance,
               int deposit,
               string ac_name,
               int account_num,
               int withdrawal);
    this.balance=balance;
    this.deposit=deposit;
    this.ac_name=ac_name;
    this.withdrawal=withdrawal;
    this.account_num=account_num;
  endfunction
   function void display();

    $display("ACCOUNT HOLDER = %s", ac_name);
    $display("ACCOUNT NUMBER = %0d", account_num);
    $display("INITIAL BALANCE = %0d", balance);
    $display("DEPOSIT        = %0d", deposit);
    $display("WITHDRAWAL     = %0d", withdrawal);
    $display("FINAL BALANCE  = %0d",
              balance + deposit - withdrawal);

  endfunction

endclass
