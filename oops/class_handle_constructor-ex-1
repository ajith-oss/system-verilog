class transaction;
  bit[7:0] a;
  bit[7:0] b;
  bit[1:0] op;
function new(bit[7:0] a,
             bit[7:0] b,
             bit[1:0] op);
  this.a=a;
  this.b=b;
  this.op=op;
  $display("constructor Executed");
endfunction
endclass
module tb;
  transaction t1;
  transaction t2;
  transaction t3;
  initial begin
    t1=new(10,20,0);
    t2=new(12,17,1);
    t3=t1;
    t3.a=100;
    $display("\nT1");
    $display("a=%0d b=%0d op=%0d",
             t1.a,t1.b,t1.op);

    $display("\nT2");
    $display("a=%0d b=%0d op=%0d",
             t2.a,t2.b,t2.op);

    $display("\nTR3");
    $display("a=%0d b=%0d op=%0d",
             t3.a,t3.b,t3.op);
  end
endmodule
