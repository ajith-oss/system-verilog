class packet;
  rand bit [7:0] addr;
  static constraint c1{
    addr inside{[10:15]};
  }
endclass
module tb;
  packet p1,p2;
  initial begin
    p1=new();
    p2=new();
    
    p1.randomize();
    p2.randomize();
    $display("randomized=%0d",p1.addr);
    $display("randomized=%0d",p2.addr);
    packet::c1.constraint_mode(0);
    p1.randomize();
    p2.randomize();
    $display("randomized=%0d",p1.addr);
    $display("randomized=%0d",p2.addr);
  end
endmodule
    
    
