class packet;
  rand bit [7:0] data[5];
  //consicutive
  constraint c1{
    foreach(data[i])
      if(i>0)
        data[i]==data[i-1]-1;
  }
  //even
   constraint c2{
    foreach(data[i])
      data[i]%2==0;
   }
            

endclass
module tb;
  packet p1;
  initial begin
    p1=new();
    p1.randomize();
    $display("randomized value=%0p",p1.data);
  end
endmodule
