module test_tb;
  logic [3:0]a;
  wire b;
  reg c;
  integer d;
  time e;
  real r;
  initial begin
    $display("default value of logic=%d",a);
    $display("default value of wire=%d",b);
    $display("default value of reg=%d",c);
    $display("default value of integer=%0d",d);
    $display("default value of time=%0d",e);
    $display("default value of real=%0d",r);
    #10;
    a=4'b0101;
    c=1'b0;
    d=4'b0101;
    e=0;
    r=1'b1;
    $display("after initialization value of logic=%b",a);
    $display("after initialization value of reg=%d",c);
    $display("after initialization value of integer=%0d",d);
    $display("after initialization value of time=%0d",e);
    $display("after initialization value of real=%0d",r);
    
  end
endmodule
